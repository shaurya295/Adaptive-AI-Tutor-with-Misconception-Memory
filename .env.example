# Copy to .env (./run.sh setup does it for you). Every value here has a working default.

# --- AI model (Ollama) -------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# The one model every agent uses. gemma4:e2b suits a laptop with ~7 GB RAM;
# gemma4:e4b is a little better but needs more memory.
TUTOR_MODEL=gemma4:e2b
# Embedding model for the curriculum search
EMBED_MODEL=nomic-embed-text
# Optional tuning
TUTOR_NUM_CTX=2048
TUTOR_KEEP_ALIVE=30m
TUTOR_LLM_TIMEOUT=180
# TUTOR_LLM=fake        # canned replies instead of a model (tests, demos without Ollama)

# --- Storage -----------------------------------------------------------------
# Leave empty for the default SQLite file in backend/data/. Any SQLAlchemy URL works,
# e.g. postgresql+psycopg2://user:pass@host:5432/tutor
DATABASE_URL=

# --- Teachers (sign-in is by email) -------------------------------------------
TEACHER_EMAILS=
TEACHER_EMAIL_DOMAINS=.edu,.ac.in,.ac.uk,.edu.au,.k12.us
